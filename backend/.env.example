# Copy this file to backend/.env ONLY if you need non-default settings.
# A stock XAMPP setup works with NO .env file at all: every value below
# matches the built-in defaults in backend/db.js.

# MySQL host (XAMPP runs MySQL on the same machine)
DB_HOST=localhost

# MySQL user (XAMPP default is root)
DB_USER=root

# MySQL password (empty on a stock XAMPP install)
DB_PASSWORD=

# Database name (created by importing database/schema.sql)
DB_NAME=ecom

# MySQL port (XAMPP default)
DB_PORT=3306

# Port the Express API listens on (the frontend expects 5000)
PORT=5000
